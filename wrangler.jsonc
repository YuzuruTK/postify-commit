{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postify-commit",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-26",
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "LINKEDIN_KV",
      "id": "REPLACE_WITH_CLOUDFLARE_KV_NAMESPACE_ID"
    }
  ]
}
